{
  "name": "simpastil-server",
  "version": "1.1.1",
  "description": "Sync server and API for the Simpastil medication tracker",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "dev": "node --env-file=.env ./node_modules/.bin/tsx watch src/index.ts",
    "build": "tsc",
    "build:outbox": "npm run build",
    "start": "node dist/index.js",
    "start:outbox": "node dist/outbox/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:migrate:dev": "bash scripts/db-migrate-dev.sh",
    "db:studio": "drizzle-kit studio",
    "db:setup-test": "bash scripts/setup-test-db.sh",
    "provision": "node dist/db/provision.js",
    "openapi:generate": "npm run build && node scripts/generate-openapi.mjs",
    "openapi:check": "npm run build && node scripts/generate-openapi.mjs --check",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "node scripts/run-tests.mjs --watch"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.5",
    "@fastify/rate-limit": "^11.2.1",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "nodemailer": "^10.1.7",
    "otpauth": "^9.5.2",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.13.0",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^7.0.11",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
