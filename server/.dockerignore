# The API build is deny-by-default; only manifests, compiler config, and source
# are available to Docker. Production and migration sources remain included,
# plus the admin console sources the image builds and serves.
**
!package.json
!package-lock.json
!tsconfig.json
!drizzle.config.ts
!src/
!src/**
!admin/package.json
!admin/package-lock.json
!admin/index.html
!admin/vite.config.ts
!admin/tsconfig.json
!admin/src/
!admin/src/**

src/test/
src/**/__tests__/
src/**/*.test.ts
src/**/*.spec.ts
src/db/acceptance/
src/db/migrations/backups/
src/**/fixtures/
src/**/.env*
src/**/*.pem
src/**/*.key
admin/**/node_modules
admin/**/dist
admin/**/coverage
admin/**/.env*
admin/**/*.pem
admin/**/*.key
admin/src/**/*.test.ts
admin/src/**/*.spec.ts
