# Copy to .env and fill in values. Never commit .env to version control.

# Local development values for the throwaway database from
# docker-compose.dev.yml and scripts/setup-test-db.sh (both use "devpassword").
# The API connects as the least-privilege app_user role so row-level security applies.
DATABASE_URL=postgresql://app_user:devpassword@localhost:5432/simpastil

# Superuser connection for migrations (npm run db:migrate:dev) and RLS test setup
DATABASE_URL_SUPER=postgresql://postgres:devpassword@localhost:5432/simpastil
DATABASE_URL_APP=postgresql://app_user:devpassword@localhost:5432/simpastil

# JWT — generate with: npx tsx scripts/generate-keys.ts
# Paste the output values here. Keep JWT_PRIVATE_KEY secret.
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ACCESS_TOKEN_TTL_SECONDS=900

# Encryption key for TOTP secrets and API keys — generate with: openssl rand -hex 32
TOTP_ENC_KEY=

# Delivery payload key — generate with: openssl rand -hex 32
DELIVERY_PAYLOAD_KEY=

# Node environment
NODE_ENV=development
PORT=3000

# Reverse-proxy hops whose X-Forwarded-For entry is trusted for request.ip
# (rate limiting). Default 1; use 0 when the API is exposed without a proxy.
# TRUSTED_PROXY_HOPS=1

# CORS allowed origins (comma-separated). When unset, all origins are allowed (dev only).
# CORS_ORIGIN=https://app.example.test

# Initial admin setup (optional — alternative to POST /admin/setup)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# PostgreSQL connection pool size (optional, default 10)
# POSTGRES_MAX_CONNECTIONS=10

# SMTP is optional. The isolated outbox worker reads all of it; the API reads only
# whether SMTP_HOST is set, to decide if reset links are emailed. A blank host
# means no email: the worker idles and the administrator issues reset links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@simpastil.local
# Public URL used in reset and invitation links. Production must use HTTPS.
PUBLIC_APP_URL=http://127.0.0.1:3000
