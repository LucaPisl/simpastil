<?xml version="1.0" encoding="utf-8"?>
<!-- Notification small icon: the Simpastil capsule, tilted like the in-app
     mark. Alpha-only (white on transparent); Android tints it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="-32">
        <!-- Outline of the whole capsule. -->
        <path
            android:pathData="M12,2.6 A5.4,5.4 0 0 1 17.4,8 V16 A5.4,5.4 0 0 1 6.6,16 V8 A5.4,5.4 0 0 1 12,2.6 Z"
            android:strokeWidth="1.8"
            android:strokeColor="#FFFFFFFF"
            android:fillColor="#00000000" />
        <!-- Filled lower half, separated from the upper half by a seam. -->
        <path
            android:pathData="M6.6,12.9 H17.4 V16 A5.4,5.4 0 0 1 6.6,16 Z"
            android:fillColor="#FFFFFFFF" />
        <!-- A dot and a dash in the upper half. -->
        <path
            android:pathData="M10.1,8.6 m-1,0 a1,1 0 1 1 2,0 a1,1 0 1 1 -2,0 Z"
            android:fillColor="#FFFFFFFF" />
        <path
            android:pathData="M12.2,8 H14.4 A0.6,0.6 0 0 1 14.4,9.2 H12.2 A0.6,0.6 0 0 1 12.2,8 Z"
            android:fillColor="#FFFFFFFF" />
    </group>
</vector>
