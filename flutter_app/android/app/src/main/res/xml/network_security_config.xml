<?xml version="1.0" encoding="utf-8"?>
<!--
    Network security configuration.

    In release builds the app communicates only over HTTPS with a pinned
    certificate — this file adds no extra trust anchors.

    In debug/dev the server runs as plain HTTP on the host machine.
    Android 9+ blocks cleartext by default, so we explicitly allow it for
    the Android emulator's host alias (10.0.2.2) only.
    This address is unreachable from real devices and from the internet,
    so there is no production risk in shipping this rule.
-->
<network-security-config>
    <!-- Allow cleartext HTTP to the Android emulator host (dev only). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>

    <!-- All other traffic must use HTTPS (system default on API 28+). -->
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
