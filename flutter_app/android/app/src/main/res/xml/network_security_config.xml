<?xml version="1.0" encoding="utf-8"?>
<!--
    Network security configuration.

    Android applies this file to its platform HTTP stack (HttpURLConnection,
    WebView). The Flutter client's HTTP traffic goes through dart:io, which
    sets up TLS itself and, as far as we know, does not consult this file, so
    do not rely on it for the client's trust or cleartext policy. This file
    adds no trust anchors. Server certificate pinning is enforced in Dart
    (see docs/ARCHITECTURE.md).

    In debug/dev the server runs as plain HTTP on the host machine.
    Android 9+ blocks cleartext by default, so we explicitly allow it for
    the Android emulator's host alias (10.0.2.2) only.
    This address is unreachable from real devices and from the internet,
    so there is no production risk in shipping this rule.
-->
<network-security-config>
    <!-- Allow cleartext HTTP to the Android emulator host (dev only). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>

    <!-- All other traffic must use HTTPS (system default on API 28+). -->
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
