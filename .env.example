# Compose environment template for the supported Docker Compose deployment.
#
# scripts/init-deploy.sh writes a filled-in copy for a new install. To write one
# by hand, copy this to a protected location OUTSIDE the checkout (for example
# /secure/simpastil/compose.env, mode 0600), edit it, and pass it explicitly:
#
#   docker compose --env-file /secure/simpastil/compose.env up --detach --build
#
# This file holds public settings and PATHS to secret files, never secret
# values. DEPLOYMENT.md shows how to generate each secret file. Never commit the
# filled-in copy. For a local development API use server/.env.example instead.

COMPOSE_PROJECT_NAME=simpastil-production
# Add :docker-compose.host-proxy.yml when a reverse proxy on the host
# terminates TLS (see DEPLOYMENT.md, "Topology and prerequisites").
# COMPOSE_FILE=/srv/simpastil/docker-compose.yml

# One canonical public HTTPS origin (default HTTPS port is 34857), used in
# reset/invitation links, and the browser origin allowed by CORS.
PUBLIC_APP_URL=https://your.host.example:34857
CORS_ORIGIN=https://your.host.example:34857

# Outbox mail delivery. The outbox worker requires SMTP_HOST. SMTP_FROM is
# optional (default noreply@simpastil.local); set a sender your host accepts.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM="Simpastil <sender@example.com>"

# Secret files (mounted read-only into the services that need them).
POSTGRES_PASSWORD_FILE=/secure/simpastil/postgres_password
DATABASE_URL_SUPER_FILE=/secure/simpastil/database_url_super
DATABASE_URL_FILE=/secure/simpastil/database_url_app
DATABASE_URL_OUTBOX_FILE=/secure/simpastil/database_url_outbox
APP_USER_PASSWORD_FILE=/secure/simpastil/app_user_password
OUTBOX_USER_PASSWORD_FILE=/secure/simpastil/outbox_user_password
JWT_PRIVATE_KEY_FILE=/secure/simpastil/jwt_private.pem
JWT_PUBLIC_KEY_FILE=/secure/simpastil/jwt_public.pem
# Exactly 64 hex characters each (openssl rand -hex 32). Back these up
# separately: losing TOTP_ENC_KEY locks out every two-factor user.
TOTP_ENC_KEY_FILE=/secure/simpastil/totp_encryption_key
DELIVERY_PAYLOAD_KEY_FILE=/secure/simpastil/delivery_payload_key
# SMTP credentials are optional: delete both lines for an unauthenticated relay.
# If set, both files must exist and be non-empty.
SMTP_USER_FILE=/secure/simpastil/smtp_user
SMTP_PASS_FILE=/secure/simpastil/smtp_password

# Automatic pre-migration backups (required): a host directory outside the
# checkout, mode 0700, owned by this UID/GID (default 1001). Bundles are as
# sensitive as the database.
SIMPASTIL_BACKUP_DIR=/secure/simpastil-backups
SIMPASTIL_BACKUP_UID=1000
SIMPASTIL_BACKUP_GID=1000
# SIMPASTIL_BACKUP_KEEP=5
# The served certificate, fingerprinted into backups. With a host proxy, the
# certificate that proxy serves.
TLS_CERT_FILE=/srv/simpastil/nginx/certs/cert.pem

# Optional (defaults shown). The port-80 redirect follows NGINX_HTTPS_PORT; set
# NGINX_PUBLIC_HTTPS_PORT only when clients reach HTTPS on another port.
# SIMPASTIL_VERSION is the server release to run; only a rollback sets it.
# SIMPASTIL_VERSION=1.1.1
# SIMPASTIL_SUBNET=10.200.1.0/24
# API_HOST_PORT=34857
# NGINX_PUBLIC_HTTPS_PORT=34857
# POSTGRES_USER=postgres
# POSTGRES_DB=simpastil
# POSTGRES_MAX_CONNECTIONS=10
# NGINX_HOST_IP=0.0.0.0
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=34857
# SHUTDOWN_TIMEOUT_MS=30000
# Reverse-proxy hops in front of the API whose X-Forwarded-For entry is trusted
# (default 1: the bundled nginx, or one host proxy publishing the API directly).
# Use 2 only when a proxy chain appends to X-Forwarded-For at each hop.
# TRUSTED_PROXY_HOPS=1
# Once a day the API asks GitHub whether a newer release exists (on or off).
# SIMPASTIL_UPDATE_CHECK=on
# OUTBOX_BATCH_SIZE=10
# OUTBOX_LEASE_MS=60000
# OUTBOX_POLL_INTERVAL_MS=2000
# OUTBOX_POSTGRES_MAX_CONNECTIONS=2
# OUTBOX_SHUTDOWN_TIMEOUT_MS=30000
# RELEASE_ID is managed by the upgrade procedure; leave it unset.
